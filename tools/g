#!/usr/bin/env bash
# Runs Godot 4.7.2 with settings private to this worktree, so parallel runs never collide.
root=$(git rev-parse --show-toplevel)
export XDG_CONFIG_HOME="$root/.xdg/config" XDG_DATA_HOME="$root/.xdg/data" XDG_CACHE_HOME="$root/.xdg/cache"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME/godot"
ln -sfn "$HOME/.local/share/godot/export_templates" "$XDG_DATA_HOME/godot/export_templates"
exec godot47 "$@"
